<Window x:Class="IPAM_WPF_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IP Address Management System"
        Height="650"
        Width="1100"
        MinHeight="550"
        MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="IP Address Management System"
                       FontSize="28"
                       FontWeight="Bold" />
            <TextBlock Text="Subnetze verwalten und IP-Adressen reservieren oder zuweisen."
                       Margin="0,5,0,0"
                       Foreground="DimGray" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- SUBNETZE -->
            <GroupBox Grid.Column="0" Header="Subnetze" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="SubnetDataGrid"
                              Grid.Row="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionChanged="SubnetDataGrid_SelectionChanged"
                              Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"
                                                Binding="{Binding Name}"
                                                Width="*" />
                            <DataGridTextColumn Header="Beschreibung"
                                                Binding="{Binding Beschreibung}"
                                                Width="2*" />
                            <DataGridTextColumn Header="Erstellt"
                                                Binding="{Binding Erstellt}"
                                                Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1"
                            BorderBrush="LightGray"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10">
                        <StackPanel>
                            <TextBlock Text="Neues Subnet"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="Name / CIDR" />
                            <TextBox x:Name="SubnetNameTextBox"
                                     Margin="0,3,0,8"
                                     ToolTip="Beispiel: Server-Netz 10.10.10.0/24" />

                            <TextBlock Text="Beschreibung" />
                            <TextBox x:Name="SubnetBeschreibungTextBox"
                                     Margin="0,3,0,10"
                                     Height="55"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Subnet hinzufügen"
                                        Click="AddSubnetButton_Click"
                                        Padding="12,6"
                                        Margin="0,0,8,0" />
                                <Button Content="Ausgewähltes löschen"
                                        Click="DeleteSubnetButton_Click"
                                        Padding="12,6" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </GroupBox>

            <!-- IP-ADRESSEN -->
            <GroupBox Grid.Column="2" Header="IP-Adressen" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="SelectedSubnetTextBlock"
                               Grid.Row="0"
                               Text="Bitte zuerst ein Subnet auswählen."
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />

                    <DataGrid x:Name="IpAdresseDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="IP-Adresse"
                                                Binding="{Binding Titel}"
                                                Width="*" />
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2"
                            BorderBrush="LightGray"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10">
                        <StackPanel>
                            <TextBlock Text="IP-Adresse verwalten"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="Neue IP-Adresse" />
                            <TextBox x:Name="IpAdresseTextBox"
                                     Margin="0,3,0,10"
                                     ToolTip="Beispiel: 10.10.10.25" />

                            <WrapPanel>
                                <Button Content="IP hinzufügen"
                                        Click="AddIpAdresseButton_Click"
                                        Padding="12,6"
                                        Margin="0,0,8,8" />
                                <Button Content="Status weiter"
                                        Click="AdvanceStatusButton_Click"
                                        Padding="12,6"
                                        Margin="0,0,8,8" />
                                <Button Content="IP löschen"
                                        Click="DeleteIpAdresseButton_Click"
                                        Padding="12,6"
                                        Margin="0,0,8,8" />
                            </WrapPanel>

                            <TextBlock Text="Workflow: Frei → Reserviert → Zugewiesen → Frei"
                                       Foreground="DimGray"
                                       FontStyle="Italic" />
                        </StackPanel>
                    </Border>
                </Grid>
            </GroupBox>
        </Grid>

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Foreground="Gray"
                   Text="SQLite-Datenbank: app.db" />
    </Grid>
</Window>
